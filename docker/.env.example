# Copie para .env e ajuste.
N8N_VERSION=latest
N8N_HOST_PORT=5679
REMBG_VERSION=latest
REMBG_HOST_PORT=7000
TZ=America/Sao_Paulo

# Pasta REAL do host que receberá os .glb (montada em /assets no container).
# Linux/macOS: /home/voce/GameAssets      Windows (Docker Desktop): C:/Assets
ASSETS_HOST_PATH=../assets

# Pasta das prévias 2D da página de revisão (precisa existir e pertencer ao PUID).
PREVIEWS_HOST_PATH=../previews

# UID/GID do seu usuário (Linux: `id -u` / `id -g`). No Windows pode deixar 1000.
PUID=1000
PGID=1000

